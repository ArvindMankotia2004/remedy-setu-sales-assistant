# Copy this file to ".env" and fill in ONE AI key (optional).
# Without any key the app still works fully using the built-in rule engine.

# --- Option A: Google Gemini (free key: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# --- Option B: Groq (free key: https://console.groq.com/keys) ---
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Option C: OpenAI or any OpenAI-compatible API ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Force a provider if you set more than one key: gemini | groq | openai | none
# AI_PROVIDER=

# Optional: protect the tool with a password (browser asks; username: sales)
# APP_PASSWORD=

# PORT=3000
